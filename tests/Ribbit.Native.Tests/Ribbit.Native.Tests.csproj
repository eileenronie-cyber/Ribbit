<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEPARATE FROM Ribbit.Tests ON PURPOSE.

    Ribbit.Tests references only Ribbit.Geometry and must stay that way: it is
    the suite that proves the solvers without a Revit anywhere in sight, and it
    runs in a quarter of a second because of it.

    This one references Ribbit.Native, and therefore the Revit API - through the
    NuGet reference assemblies when Revit is not installed, so it still builds on
    any machine. It covers the clash code in the add-in that needs no open
    model: comments, set transfer, title migration, known users and workset
    exclusion. Anything that needs a live Revit is not tested here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ribbit.Native\Ribbit.Native.csproj" />
  </ItemGroup>

</Project>
